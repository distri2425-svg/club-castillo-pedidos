# Base de datos
DB_DATABASE=castillo_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_PORT_HOST=5432

# Puertos expuestos (cambiar si hay conflictos)
BACKEND_PORT=8081
FRONTEND_PORT=5173

# JWT
SECRET_KEY_JWT=your_jwt_secret_key_here

# Asistente virtual (backend). Sin este valor el asistente responde unicamente
# con el repertorio local de la aplicacion del cliente, sin consultar el
# servicio externo. GEMINI_MODEL es opcional.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Clave de las cuentas iniciales que siembra el sistema en una base vacia
# (owner@club.com, admin@restaurant.com, customer@club.com e invitado@club.com).
# Si se omite, el arranque genera una aleatoria y la deja en la bitacora.
SEED_USER_PASSWORD=password
